<?xml version="1.0" encoding="utf-8"?>
<!-- TextureView instead of the default SurfaceView: SurfaceView is composited by the OS as a
     separate window layer positioned by absolute screen coordinates, which doesn't reliably stay
     in sync with a parent that's inside a pager (pages recomposing) and under a pinch-zoom
     graphicsLayer transform -- the video can end up rendered shrunk and mispositioned. TextureView
     draws as a normal View layer instead, so it always follows its Compose-measured bounds. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false" />
